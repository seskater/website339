# Copy to .env and fill in. start.py / run.sh load it automatically.

# Anthropic API key from https://console.anthropic.com (leave empty for free photo matching)
ANTHROPIC_API_KEY=
# Model: claude-haiku-5-5 (default, under 1 cent per search) or claude-opus-5-5 (best, ~$0.20-0.50)
VINTED_FINDER_MODEL=claude-haiku-5-5
# Searches per visitor per day
DAILY_LIMIT=20
# Optional: your Vinted Cookie header, to import all your likes from the CLI
VINTED_COOKIE=
